generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  SUPER_ADMIN
}

enum RequestScope {
  ALL_SELLERS
  CATEGORY_SELLERS
}

enum NotificationSound {
  DEFAULT
  CHIME
  DING
  POP
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  SYSTEM
}

model Category {
  id       String   @id @default(cuid())
  name     String   @unique
  users    User[]
  requests Request[]
}

model User {
  id           String   @id @default(cuid())
  role         Role
  fullName     String
  email        String   @unique
  passwordHash String
  tip          String?

  // Public profile image (served via /uploads/...)
  avatarUrl    String?

  /// Expo push token for sending push notifications to this user.
  /// (Optional: user may never grant permissions.)
  expoPushToken String?

  // Push notification preferences
  pushEnabled      Boolean           @default(true)
  pushSoundEnabled Boolean           @default(true)
  pushSound        NotificationSound @default(DEFAULT)

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])

  buyerRequests      Request[]         @relation("BuyerRequests")
  acceptedRequests   AcceptedRequest[]
  conversationsA     Conversation[]    @relation("ConvA")
  conversationsB     Conversation[]    @relation("ConvB")
  messages           Message[]
  notifications      Notification[]

  blocked       Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?
  blockedById   String?

  createdAt DateTime @default(now())
}

model Request {
  id         String       @id @default(cuid())
  title      String
  imageUrl   String?
  scope      RequestScope

  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id])

  buyerId    String
  buyer      User         @relation("BuyerRequests", fields: [buyerId], references: [id])

  accepted   AcceptedRequest?
  createdAt  DateTime     @default(now())
}

model AcceptedRequest {
  id        String   @id @default(cuid())
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id])

  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id])

  conversation Conversation?

  createdAt DateTime @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("ConvA", fields: [userAId], references: [id])
  userB     User     @relation("ConvB", fields: [userBId], references: [id])

  acceptedRequestId String? @unique
  acceptedRequest   AcceptedRequest? @relation(fields: [acceptedRequestId], references: [id])

  messages  Message[]
  createdAt DateTime @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  type           MessageType  @default(TEXT)
  text           String?

  // For IMAGE/AUDIO messages (served via /uploads/...)
  mediaUrl       String?
  mediaMime      String?
  mediaDuration  Int?

  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  title     String
  body      String
  type      String?  // e.g. "BLOCKED", "INFO"
  readAt    DateTime?
  createdAt DateTime @default(now())
}
