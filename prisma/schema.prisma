generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  SUPER_ADMIN
}

enum RequestScope {
  ALL_SELLERS
  CATEGORY_SELLERS
}

enum NotificationSound {
  DEFAULT
  CHIME
  DING
  POP
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  SYSTEM
}

enum LegalPageType {
  PRIVACY
  TERMS
}

model Category {
  id       String   @id @default(cuid())
  name     String   @unique
  users    User[]
  requests Request[]
}

model User {
  id           String   @id @default(cuid())
  role         Role
  fullName     String
  email        String   @unique
  passwordHash String
  tip          String?

  // Contact info (required for SELLER: at least one of phone/whatsapp)
  phone        String?
  whatsapp     String?

  // Public profile image (served via /uploads/...)
  avatarUrl    String?

  /// Expo push token for sending push notifications to this user.
  /// (Optional: user may never grant permissions.)
  expoPushToken String?

  // Push notification preferences
  pushEnabled      Boolean           @default(true)
  pushSoundEnabled Boolean           @default(true)
  pushSound        NotificationSound @default(DEFAULT)

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])

  buyerRequests      Request[]         @relation("BuyerRequests")
  acceptedRequests   AcceptedRequest[]
  conversationsA     Conversation[]    @relation("ConvA")
  conversationsB     Conversation[]    @relation("ConvB")
  messages           Message[]
  notifications      Notification[]

  reportsMade        MessageReport[] @relation("ReportBy")
  reportsReceived    MessageReport[] @relation("ReportTarget")
  moderationEvents   ModerationEvent[]

  // General (non-chat) user complaints
  complaintsMade     UserComplaint[] @relation("ComplaintBy")
  complaintsReceived UserComplaint[] @relation("ComplaintTarget")

  blocked       Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?
  blockedById   String?

  // Security / moderation
  tokenVersion      Int      @default(0) // increment to invalidate all tokens (force logout)
  moderationStrikes Int      @default(0)
  chatFrozenUntil   DateTime?
  reportCount       Int      @default(0)

  createdAt DateTime @default(now())
}

model UserComplaint {
  id           String       @id @default(cuid())

  reporterId   String
  reporter     User         @relation("ComplaintBy", fields: [reporterId], references: [id])

  targetUserId String
  targetUser   User         @relation("ComplaintTarget", fields: [targetUserId], references: [id])

  /// Optional context: complaint about a specific request.
  requestId    String?
  request      Request?     @relation("ComplaintRequest", fields: [requestId], references: [id])

  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  @@index([targetUserId])
  @@index([status])
  @@index([createdAt])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model MessageReport {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation("ConversationMessageReports", fields: [conversationId], references: [id])

  messageId      String
  message        Message      @relation("MessageMessageReports", fields: [messageId], references: [id])

  reporterId     String
  reporter       User         @relation("ReportBy", fields: [reporterId], references: [id])

  targetUserId   String
  targetUser     User         @relation("ReportTarget", fields: [targetUserId], references: [id])

  reason         String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@unique([reporterId, messageId])
  @@index([targetUserId])
  @@index([status])
}

model ModerationEvent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  conversationId String?
  messageText    String?
  reasonCode     String
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([reasonCode])
}

model LegalPage {
  id        String        @id @default(cuid())
  type      LegalPageType @unique
  title     String
  /// Stored as HTML (recommended) or plain text.
  content   String
  updatedAt DateTime      @updatedAt
  createdAt DateTime      @default(now())
  updatedById String?

  @@index([type])
}

model Request {
  id         String       @id @default(cuid())
  title      String
  imageUrl   String?
  scope      RequestScope

  /// Category is required only when scope=CATEGORY_SELLERS.
  /// When scope=ALL_SELLERS, category can be null.
  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id])

  buyerId    String
  buyer      User         @relation("BuyerRequests", fields: [buyerId], references: [id])

  /// Complaints that reference this request (optional).
  complaints UserComplaint[] @relation("ComplaintRequest")

  accepted   AcceptedRequest?
  createdAt  DateTime     @default(now())
}

model AcceptedRequest {
  id        String   @id @default(cuid())
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id])

  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id])

  /// Seller note/description when accepting a request.
  sellerNote String?

  /// Optional image the seller sends when accepting.
  sellerImageUrl String?

  conversation Conversation?

  createdAt DateTime @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("ConvA", fields: [userAId], references: [id])
  userB     User     @relation("ConvB", fields: [userBId], references: [id])

  acceptedRequestId String? @unique
  acceptedRequest   AcceptedRequest? @relation(fields: [acceptedRequestId], references: [id])

  // Reports for messages that belong to this conversation
  messageReports MessageReport[] @relation("ConversationMessageReports")

  messages  Message[]
  createdAt DateTime @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  type           MessageType  @default(TEXT)
  text           String?

  // For IMAGE/AUDIO messages (served via /uploads/...)
  mediaUrl       String?
  mediaMime      String?
  mediaDuration  Int?

  createdAt      DateTime     @default(now())

  // Reports for this message
  reports MessageReport[] @relation("MessageMessageReports")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  title     String
  body      String
  type      String?  // e.g. "BLOCKED", "INFO"
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
}
